# Clever Marketing — local environment configuration
# Safe template; copy to .env and keep real API keys out of Git. Netlify deploys require variables configured in Netlify.
# Hugo does not automatically read .env; Netlify CLI can load it for local development.
# Analytics loaders also require a production build; leave normal local previews in development mode.

# Existing Google Analytics measurement ID; public identifier.
GA_TRACKING_ID='G-3XNGWVG5S4'

# Existing Meta Pixel ID; public identifier.
META_PIXEL_ID='1414254096308301'

# Secret build-time Places API key. Leave blank until supplied securely.
HUGO_GOOGLE_PLACES_API_KEY=''

# Secret server-side Resend API key. Delivery remains disabled until explicitly enabled.
RESEND_API_KEY=''

# Approved sender address on the configured Resend domain.
RESEND_FROM_EMAIL='Clever Marketing <noreply@getclever.marketing>'

# Approved reply-to address; distinct from the notification recipient.
RESEND_REPLY_TO_EMAIL='lets@getclever.marketing'

# Proposed recipient: existing business inbox; confirm before enabling delivery.
RESEND_TO_EMAIL='lets@getclever.marketing'

# GitHub Actions secret (configured separately): NETLIFY_BUILD_HOOK_URL


# Resend form-event delivery is opt-in. Keep staging in test mode.
FORM_EMAIL_ENABLED='false'
FORM_EMAIL_MODE='test'
# Netlify metadata ID of the accepted contact form, not its display name.
FORM_EMAIL_CONTACT_FORM_ID=''
# Both messages go here in test mode; never to a submitted customer address.
FORM_EMAIL_TEST_TO='lets@getclever.marketing'

# Custom Functions-runtime identity. Set only in Netlify's production context.
# Netlify's built-in CONTEXT/BRANCH variables are unavailable at function runtime.
FORM_EMAIL_DEPLOY_CONTEXT=''
FORM_EMAIL_DEPLOY_BRANCH=''
